{% extends 'base.html.twig' %}

{% block title %}Infos Billet{% endblock %}

{% block body %}
<div class="container mt-4">
    {% if ticket %}
        <h2>{{ ticket.event.title }} 🎫</h2>
        <p><strong>Type de billet :</strong> {{ ticket.ticketType.name }}</p>
        <p><strong>Nom du client :</strong> {{ ticket.customerName }}</p>
        <p><strong>Email :</strong> {{ ticket.customerEmail }}</p>
        <p><strong>Date d'achat :</strong> {{ ticket.purchasedAt|date('d/m/Y H:i') }}</p>
        <p><strong>Statut :</strong> <span class="badge {{ ticket.getStatusBadgeClass() }}">{{ ticket.getStatusLabel() }}</span></p>

        {% if ticket.payment %}
            <h4 class="mt-3">Paiement 💳</h4>
            <p><strong>Montant :</strong> {{ ticket.payment.getFormattedAmount() }}</p>
            <p><strong>Méthode :</strong> {{ ticket.payment.method }}</p>
        {% endif %}

        {# {% if ticket.pdfPath %}
            <a href="{{ asset(ticket.pdfPath) }}" class="btn btn-primary mt-3" target="_blank">Télécharger le billet PDF</a>
        {% endif %} #}

        {# {% if ticket.qrCodeImagePath %}
            <div class="mt-3">
                <img src="{{ asset(ticket.qrCodeImagePath) }}" alt="QR Code du billet" style="max-width:200px;">
            </div>
        {% endif %} #}
    {% else %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endif %}
</div>
{% endblock %}
