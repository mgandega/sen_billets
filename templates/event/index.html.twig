{% extends 'base.html.twig' %}

{% block title %}Événements - Sen-Billets{% endblock %}

{% block body %}
<style>
/* Conteneur pour la zone d’image */
.event-image-wrapper {
    width: 100%;
    height: 220px; /* valeur par défaut sur grands écrans */
    overflow: hidden;
    border-radius: .5rem .5rem 0 0;
    background: #f8f9fa; /* fond neutre derrière l’image */
    display: flex;
    align-items: center;
    justify-content: center;
}

/* L’image s’adapte sans être rognée */
.event-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
}

/* Petits écrans */
@media (max-width: 576px) {
    .event-image-wrapper {
        height: 150px;
    }
}

/* Écrans moyens */
@media (min-width: 577px) and (max-width: 992px) {
    .event-image-wrapper {
        height: 180px;
    }
}

/* Grands écrans */
@media (min-width: 993px) {
    .event-image-wrapper {
        height: 220px;
    }
}
</style>

<!-- Hero Section -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">Découvrez les événements</h1>
                <p class="lead mb-4">Trouvez les meilleurs événements au Sénégal et réservez vos billets en quelques clics</p>
            </div>
            <div class="col-lg-4 text-end">
                {% if is_granted('ROLE_ORGANIZER') %}
                    <a href="{{ path('event_new') }}" class="btn btn-warning btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Créer un événement
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<!-- Search and Filters -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row g-3">
            <div class="col-lg-6">
                <form method="get" class="d-flex">
                    <input type="text" name="search" class="form-control me-2" 
                           placeholder="Rechercher un événement..." 
                           value="{{ currentSearch }}">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
            <div class="col-lg-6">
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('event_index') }}" 
                       class="btn {{ currentCategory is null ? 'btn-primary' : 'btn-outline-primary' }} btn-sm">
                        Tous
                    </a>
                    {% for category in categories %}
                        <a href="{{ path('event_index', {category: category}) }}" 
                           class="btn {{ currentCategory == category ? 'btn-primary' : 'btn-outline-primary' }} btn-sm">
                            {{ category }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Events Grid -->
<section class="py-5">
    <div class="container">
        {% if events is empty %}
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold mb-3">Aucun événement trouvé</h3>
                <p class="text-muted mb-4">
                    {% if currentSearch %}
                        Aucun événement ne correspond à votre recherche "{{ currentSearch }}"
                    {% elseif currentCategory %}
                        Aucun événement dans la catégorie "{{ currentCategory }}"
                    {% else %}
                        Il n'y a pas d'événements disponibles pour le moment
                    {% endif %}
                </p>
                {% if is_granted('ROLE_ORGANIZER') %}
                    <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg">
                        Créer le premier événement
                    </a>
                {% endif %}
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in events %}
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow card-hover">
                            {% if event.imageUrl %}
                                <div class="event-image-wrapper">
                                    <img src="{{ event.imageUrl }}" class="card-img-top event-image" alt="{{ event.title }}">
                                </div>
                            {% else %}
                                <div class="bg-light d-flex align-items-center justify-content-center event-image-wrapper">
                                    <i class="bi bi-calendar-event text-muted" style="font-size: 3rem;"></i>
                                </div>
                            {% endif %}
                            
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary">{{ event.category }}</span>
                                    <small class="text-muted">{{ event.eventDate|date('d/m/Y') }}</small>
                                </div>
                                
                                <h5 class="card-title fw-bold">{{ event.title }}</h5>
                                <p class="card-text text-muted flex-grow-1">
                                    {{ event.description|slice(0, 100) }}...
                                </p>
                                
                                <div class="mb-3">
                                    <div class="d-flex align-items-center text-muted mb-1">
                                        <i class="bi bi-geo-alt me-2"></i>
                                        <small>{{ event.venue }}</small>
                                    </div>
                                    <div class="d-flex align-items-center text-muted mb-1">
                                        <i class="bi bi-clock me-2"></i>
                                        <small>{{ event.startTime|date('H:i') }}</small>
                                    </div>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-people me-2"></i>
                                        <small>{{ event.soldTickets }}/{{ event.capacity }} places</small>
                                    </div>
                                </div>

                                {% if event.ticketTypes|length > 0 %}
                                    <div class="mb-3">
                                        <span class="text-success fw-bold">
                                            À partir de {{ (event.minPrice / 100)|number_format(0, ',', ' ') }} FCFA
                                        </span>
                                    </div>
                                {% endif %}

                                <div class="mt-auto">
                                    <div class="progress mb-2" style="height: 4px;">
                                        <div class="progress-bar bg-success" 
                                             style="width: {{ event.occupancyRate }}%"></div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('event_show', {id: event.id}) }}" 
                                           class="btn btn-primary flex-fill">
                                            Voir détails
                                        </a>
                                        {% if event.isAvailable %}
                                            <button class="btn btn-success">
                                                <i class="bi bi-ticket"></i>
                                            </button>
                                        {% else %}
                                            <button class="btn btn-secondary" disabled>
                                                Complet
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <p class="text-muted">{{ events|length }} événement(s) trouvé(s)</p>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
