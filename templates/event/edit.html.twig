{% extends 'base.html.twig' %}

{% block title %}Modifier {{ event.title }} - Sen-Billets{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('event_index') }}">Événements</a></li>
                <li class="breadcrumb-item"><a href="{{ path('event_show', {id: event.id}) }}">{{ event.title }}</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-warning text-dark py-4">
                        <h1 class="h3 mb-0 fw-bold">
                            <i class="bi bi-pencil me-2"></i>Modifier l'événement
                        </h1>
                    </div>
                    
                    <div class="card-body p-5">
                        {{ form_start(form) }}
                            <div class="row g-4">
                                <!-- Informations générales -->
                                <div class="col-12">
                                    <h4 class="fw-bold text-warning mb-3">Informations générales</h4>
                                </div>
                                
                                <div class="col-md-8">
                                    {{ form_row(form.title) }}
                                </div>
                                
                                <div class="col-md-4">
                                    {{ form_row(form.category) }}
                                </div>
                                
                                <div class="col-12">
                                    {{ form_row(form.description) }}
                                </div>
                                
                                <div class="col-12">
                                    {{ form_row(form.imageUrl) }}
                                </div>

                                <!-- Date et heure -->
                                <div class="col-12">
                                    <h4 class="fw-bold text-warning mb-3">Date et heure</h4>
                                </div>
                                
                                <div class="col-md-4">
                                    {{ form_row(form.eventDate) }}
                                </div>
                                
                                <div class="col-md-4">
                                    {{ form_row(form.startTime) }}
                                </div>
                                
                                <div class="col-md-4">
                                    {{ form_row(form.endTime) }}
                                </div>

                                <!-- Lieu -->
                                <div class="col-12">
                                    <h4 class="fw-bold text-warning mb-3">Lieu</h4>
                                </div>
                                
                                <div class="col-md-6">
                                    {{ form_row(form.venue) }}
                                </div>
                                
                                <div class="col-md-6">
                                    {{ form_row(form.address) }}
                                </div>

                                <!-- Capacité et statut -->
                                <div class="col-12">
                                    <h4 class="fw-bold text-warning mb-3">Configuration</h4>
                                </div>
                                
                                <div class="col-md-6">
                                    {{ form_row(form.capacity) }}
                                </div>
                                
                                <div class="col-md-6">
                                    {{ form_row(form.status) }}
                                </div>

                                <!-- Types de billets -->
                                <div class="col-12">
                                    <h4 class="fw-bold text-warning mb-3">Types de billets</h4>
                                    <div class="alert alert-warning" role="alert">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <strong>Attention :</strong> La modification des types de billets peut affecter les réservations existantes.
                                    </div>
                                    {{ form_row(form.ticketTypes) }}
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-5">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="bi bi-check-circle me-2"></i>Sauvegarder les modifications
                                </button>
                                
                                <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-circle me-2"></i>Annuler
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}