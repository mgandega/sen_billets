        </nav>
    {% endblock %} #}
        {% block header %}
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
                        <span class="me-2">🎫</span>
                        <span class="fw-bold">Sen-Billets</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('event_index') }}">Événements</a>
                            </li>
                            {% if is_granted('ROLE_ORGANIZER') %}
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Organisateur
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="{{ path('app_dashboard') }}">Tableau de bord</a></li>
                                        <li><a class="dropdown-item" href="{{ path('event_my_events') }}">Mes événements</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="{{ path('event_new') }}">Créer un événement</a></li>
                                    </ul>
                                </li>
                            {% endif %}
                        </ul>

                        <div class="d-flex align-items-center">
                            {% if app.user %}
                                <div class="dropdown">
                                    <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-circle me-1"></i>
                                        {{ app.user.name }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="{{ path('app_profile', {'id':app.user.id})}}">Mon profil</a></li>
                                        {# <li><a class="dropdown-item" href="{{ path('ticket_my_tickets') }}">Mes billets</a></li> #}
                                        {% if is_granted('ROLE_ORGANIZER') %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ path('app_dashboard') }}">Tableau de bord</a></li>
                                        {% endif %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                                    </ul>
                                </div>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn btn-outline-light me-2">
                                    Connexion
                                </a>
                                <a href="{{ path('app_register') }}" class="btn btn-warning">
                                    Inscription
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </nav>
        {% endblock %}
    <main class="py-0">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        <footer class="bg-dark text-light py-5 mt-5">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4">
                        <h5 class="text-warning mb-3">🎫 Sen-Billets</h5>
                        <p class="text-muted">La plateforme de billetterie moderne du Sénégal.</p>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h6 class="text-white mb-3">Navigation</h6>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('app_home') }}" class="text-muted text-decoration-none">Accueil</a></li>
                            <li><a href="{{ path('event_index') }}" class="text-muted text-decoration-none">Événements</a></li>
                            <li><a href="{{ path('app_about') }}" class="text-muted text-decoration-none">À propos</a></li>
                            <li><a href="#" class="text-muted text-decoration-none">Contact</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h6 class="text-white mb-3">Organisateurs</h6>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('event_new') }}" class="text-muted text-decoration-none">Créer un événement</a></li>
                            <li><a href="{{ path('app_dashboard') }}" class="text-muted text-decoration-none">Tableau de bord</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4">
                        <h6 class="text-white mb-3">Contact</h6>
                        <p class="text-muted">
                            <i class="bi bi-geo-alt me-2"></i>Dakar, Sénégal<br>
                            <i class="bi bi-envelope me-2"></i>contact@sen-billets.sn<br>
                            <i class="bi bi-phone me-2"></i>+221 XX XXX XX XX
                        </p>
                    </div>
                </div>
                <hr class="my-4 border-secondary">
                <div class="text-center text-muted">&copy; 2024 Sen-Billets. Tous droits réservés.</div>
            </div>
        </footer>
    {% endblock %}

    {% block javascripts %}
        {# Scanner JS local #}
        <script type="module" src="{{ asset('js/scanner/scanner.js') }}"></script>

        {# Bootstrap JS depuis CDN #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        {# Config global #}
        <script>
            window.SEN_BILLETS_CONFIG = {
                baseUrl: '{{ app.request.schemeAndHttpHost }}',
                user: {% if app.user %}{{ {
                    id: app.user.id,
                    name: app.user.name,
                    email: app.user.email,
                    roles: app.user.roles
                }|json_encode|raw }}{% else %}null{% endif %}
            };
        </script>
    {% endblock %}
</body>
</html>
