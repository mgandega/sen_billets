{% extends 'base.html.twig' %}

{% block title %}Dashboard - {{ event.title }}{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="display-5 fw-bold">Dashboard de validation</h1>
            <a href="{{ path('scanner_event', {id: event.id}) }}" class="btn btn-primary">
                <i class="bi bi-qr-code-scan me-2"></i>Retour au scanner
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        {% set stats = report.stats %}
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow text-center h-100">
                <div class="card-body">
                    <i class="bi bi-ticket text-primary fs-1 mb-3"></i>
                    <h3 class="fw-bold">{{ stats.total }}</h3>
                    <p class="text-muted mb-0">Total billets</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow text-center h-100">
                <div class="card-body">
                    <i class="bi bi-check-circle text-success fs-1 mb-3"></i>
                    <h3 class="fw-bold">{{ stats.validated }}</h3>
                    <p class="text-muted mb-0">Validés</p>
                    <small class="text-success">{{ (stats.validated / stats.total * 100)|round(1) }}%</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow text-center h-100">
                <div class="card-body">
                    <i class="bi bi-clock text-warning fs-1 mb-3"></i>
                    <h3 class="fw-bold">{{ stats.pending }}</h3>
                    <p class="text-muted mb-0">En attente</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow text-center h-100">
                <div class="card-body">
                    <i class="bi bi-x-circle text-danger fs-1 mb-3"></i>
                    <h3 class="fw-bold">{{ stats.total - stats.validated - stats.pending }}</h3>
                    <p class="text-muted mb-0">Annulés</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Graph & Ticket Types -->
    <div class="row g-4">
        <!-- Validations par heure -->
        <div class="col-lg-8">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-graph-up me-2"></i>Validations par heure
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="validationChart" width="400" height="200"></canvas>
                </div>
            </div>

            <!-- Ticket Types -->
            <div class="card border-0 shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-pie-chart me-2"></i>Validation par type de billet
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Vendus</th>
                                    <th>Validés</th>
                                    <th>Taux</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for type in report.ticketTypes %}
                                    {% set rate = type.total > 0 ? (type.validated / type.total * 100) : 0 %}
                                    <tr>
                                        <td>{{ type.name }}</td>
                                        <td>{{ type.total }}</td>
                                        <td>{{ type.validated }}</td>
                                        <td>{{ rate|round(1) }}%</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dernières validations -->
        <div class="col-lg-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-clock-history me-2"></i>Dernières validations
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    {% for validation in stats.lastValidations %}
                        <div class="d-flex justify-content-between py-2 {% if not loop.last %}border-bottom{% endif %}">
                            <div>
                                <strong>{{ validation.customerName }}</strong>
                                <small class="text-muted d-block">{{ validation.ticketType.name }}</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success">Validé</span>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Aucune validation récente</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const ctx = document.getElementById('validationChart').getContext('2d');
const validationChart = new Chart(ctx, {
    type: 'line',
    data: {
        labels: Array.from({length: 24}, (_, i) => i + 'h'),
        datasets: [{
            label: 'Validations',
            data: Array(24).fill(0),
            borderColor: 'rgb(75, 192, 192)',
            backgroundColor: 'rgba(75, 192, 192, 0.1)',
            tension: 0.1,
            fill: true
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
    }
});
</script>
{% endblock %}
