{% extends 'base.html.twig' %}

{% block title %}Scanner QR - Sen-Billets{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Titre -->
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-primary mb-3">Scanner QR</h1>
                <p class="lead text-muted">Validez les billets en scannant leur QR code</p>
            </div>

            <!-- Scanner Card -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-qr-code-scan me-2"></i>Scanner de billets</h5>
                </div>
                <div class="card-body p-4">

                    <!-- Camera Preview -->
                    <div class="text-center mb-4">
                        <div id="scanner-container" class="position-relative mx-auto" style="max-width: 400px;">
                            <video id="scanner-video" class="w-100 rounded" style="display: none;"></video>
                            <canvas id="scanner-canvas" class="w-100 rounded" style="display: none;"></canvas>

                            <!-- Overlay -->
                            <div id="scanner-overlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="cursor: pointer;">
                                <div class="text-center">
                                    <i class="bi bi-camera text-muted" style="font-size: 4rem;"></i>
                                    <p class="text-muted mt-3">Cliquez pour démarrer le scanner</p>
                                    <button id="start-scanner" class="btn btn-primary btn-lg">
                                        <i class="bi bi-play-fill me-2"></i>Démarrer le scanner
                                    </button>
                                </div>
                            </div>

                            <!-- Scanner Frame -->
                            <div id="scanner-frame" class="position-absolute top-50 start-50 translate-middle" style="display: none;">
                                <div class="border border-primary border-3 rounded" style="width: 250px; height: 250px; border-style: dashed !important;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Manual Input -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label for="manual-qr" class="form-label fw-bold">Ou saisissez le code QR manuellement :</label>
                            <input type="text" class="form-control" id="manual-qr" placeholder="SB-123-456-ABC123">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button id="validate-manual" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-2"></i>Valider
                            </button>
                        </div>
                    </div>

                    <!-- Scanner Controls -->
                    <div class="d-flex gap-2 justify-content-center mb-4" id="scanner-controls" style="display: none;">
                        <button id="stop-scanner" class="btn btn-outline-danger">
                            <i class="bi bi-stop-fill me-2"></i>Arrêter
                        </button>
                        <button id="switch-camera" class="btn btn-outline-secondary">
                            <i class="bi bi-camera-reels me-2"></i>Changer caméra
                        </button>
                        <button id="toggle-flash" class="btn btn-outline-warning">
                            <i class="bi bi-lightbulb me-2"></i>Flash
                        </button>
                    </div>

                    <!-- Validation Results -->
                    <div id="validation-results"></div>
                </div>
            </div>

            <!-- Recent Validations -->
            <div class="card border-0 shadow mt-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Validations récentes</h5>
                </div>
                <div class="card-body">
                    <div id="recent-validations">
                        <p class="text-muted text-center">Aucune validation récente</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

