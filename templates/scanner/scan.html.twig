{% extends 'base.html.twig' %}

{% block title %}Scanner - {{ event.title }}{% endblock %}

{% block body %}
<div class="container text-center py-5">
    <h2>Scanner vos billets</h2>

    <video id="preview" class="w-100 rounded border" style="display:none"></video>
    <div id="scan-result" class="alert alert-secondary mt-3">En attente...</div>

    <div class="mt-3">
        <button id="start-scanner" class="btn btn-primary me-2">▶️ Démarrer le scanner</button>
        <button id="switch-camera" class="btn btn-secondary">🔄 Changer de caméra</button>
    </div>
</div>

<script src="https://unpkg.com/@zxing/library@latest"></script>
<script src="{{ asset('js/scanner/scanner.js') }}"></script>
<script>
    const scanner = new QRScanner(
        "preview", 
        "{{ path('scanner_api_validate', { qrCode: 'PLACEHOLDER' }) }}"
    );

    document.getElementById("start-scanner").addEventListener("click", () => scanner.init());
    document.getElementById("switch-camera").addEventListener("click", () => scanner.switchCamera());
</script>
{% endblock %}
