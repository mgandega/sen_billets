{% extends 'base.html.twig' %}

{% block title %}Scanner - {{ event.title }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <h2>Scanner vos billets</h2>
                <p class="text-muted">Validez les billets en scannant leur QR code</p>
            </div>

            <div class="card shadow">
                <div class="card-body position-relative">
                    <!-- Vidéo -->
                    <video id="scanner-video" class="w-100 rounded" style="display:none;"></video>

                    <!-- Overlay -->
                    <div id="scanner-overlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-camera text-muted" style="font-size:4rem;"></i>
                        <p class="text-muted mt-2">Cliquez pour démarrer le scanner</p>
                        <button id="start-scanner" class="btn btn-primary">
                            <i class="bi bi-play-fill me-2"></i>Démarrer
                        </button>
                    </div>

                    <!-- Frame de scan -->
                    <div id="scanner-frame" class="position-absolute top-50 start-50 translate-middle" style="display:none;">
                        <div class="border border-primary border-3 rounded" style="width:250px; height:250px; border-style:dashed !important;"></div>
                    </div>

                    <!-- Contrôles -->
                    <div id="scanner-controls" class="d-flex gap-2 justify-content-center mt-3" style="display:none;">
                        <button id="switch-camera" class="btn btn-secondary">
                            <i class="bi bi-camera-reels me-2"></i>Changer caméra
                        </button>
                        <button id="toggle-flash" class="btn btn-warning">
                            <i class="bi bi-lightbulb me-2"></i>Flash
                        </button>
                        <button id="stop-scanner" class="btn btn-danger">
                            <i class="bi bi-stop-fill me-2"></i>Arrêter
                        </button>
                    </div>

                    <!-- Résultats -->
                    <div id="validation-results" class="mt-3"></div>
                </div>
            </div>

            <!-- Validations récentes -->
            <div class="card shadow mt-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Validations récentes</h5>
                </div>
                <div class="card-body" id="recent-validations">
                    <p class="text-muted text-center">Aucune validation récente</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/@zxing/library@latest"></script>
<script src="{{ asset('js/scanner/pro-scanner.js') }}"></script>
<script>
    const scanner = new QRScanner(
        "scanner-video",
        "{{ app.request.schemeAndHttpHost ~ path('scanner_api_validate', { qrCode: 'PLACEHOLDER' }) }}"
    );

    document.getElementById("start-scanner").addEventListener("click", () => scanner.start());
    document.getElementById("stop-scanner").addEventListener("click", () => scanner.stop());
    document.getElementById("switch-camera").addEventListener("click", () => scanner.switchCamera());
    document.getElementById("toggle-flash").addEventListener("click", () => scanner.toggleFlash());
</script>
{% endblock %}
