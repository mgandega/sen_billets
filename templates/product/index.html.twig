{% extends 'base.html.twig' %}

{% block title %}Produits - Symfony 7.2{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-dark">Gestion des produits</h1>
                <p class="lead text-muted">Créez et gérez vos produits facilement</p>
            </div>
            <a href="{{ path('product_new') }}" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Nouveau produit
            </a>
        </div>

        {% if products is empty %}
            <div class="text-center py-5">
                <div class="mb-4">
                    <svg width="64" height="64" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                        <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976l2.61-3.045zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0zM1.5 8.5A.5.5 0 0 1 2 9v6h1v-5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v5h6V9a.5.5 0 0 1 1 0v6h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1V9a.5.5 0 0 1 .5-.5zM4 15h3v-5H4v5zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3zm3 0h-2v3h2v-3z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-3">Aucun produit trouvé</h3>
                <p class="text-muted mb-4">Commencez par créer votre premier produit</p>
                <a href="{{ path('product_new') }}" class="btn btn-primary btn-lg">
                    Créer un produit
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for product in products %}
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow card-hover">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">{{ product.name }}</h5>
                                <p class="card-text text-muted flex-grow-1">
                                    {{ product.description ? product.description|slice(0, 100) ~ '...' : 'Aucune description disponible' }}
                                </p>
                                
                                <div class="mb-3">
                                    <span class="h4 text-success fw-bold">{{ product.price }} €</span>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar me-1"></i>
                                        Créé le {{ product.createdAt|date('d/m/Y') }}
                                    </small>
                                </div>

                                <div class="d-flex gap-2 mt-auto">
                                    <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-outline-primary flex-fill">
                                        <i class="bi bi-eye me-1"></i>Voir
                                    </a>
                                    <a href="{{ path('product_edit', {id: product.id}) }}" class="btn btn-outline-secondary flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Modifier
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <p class="text-muted">{{ products|length }} produit(s) trouvé(s)</p>
            </div>
        {% endif %}
    </div>
{% endblock %}