{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Produits{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('product_index') }}">Produits</a></li>
                <li class="breadcrumb-item active">{{ product.name }}</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-primary text-white py-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="h3 mb-0 fw-bold">{{ product.name }}</h1>
                            <span class="badge bg-warning fs-6">{{ product.price }} €</span>
                        </div>
                    </div>
                    
                    <div class="card-body p-5">
                        {% if product.description %}
                            <div class="mb-4">
                                <h3 class="h5 fw-bold mb-3">Description</h3>
                                <p class="text-muted lh-lg">{{ product.description }}</p>
                            </div>
                        {% endif %}

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="bi bi-currency-euro text-success"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Prix</small>
                                        <span class="fw-bold">{{ product.price }} €</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="bi bi-calendar-plus text-info"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Date de création</small>
                                        <span class="fw-bold">{{ product.createdAt|date('d/m/Y à H:i') }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {% if product.updatedAt != product.createdAt %}
                            <div class="alert alert-light" role="alert">
                                <i class="bi bi-info-circle me-2"></i>
                                Dernière modification : {{ product.updatedAt|date('d/m/Y à H:i') }}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-3 flex-wrap">
                            <a href="{{ path('product_edit', {id: product.id}) }}" class="btn btn-primary">
                                <i class="bi bi-pencil me-2"></i>Modifier
                            </a>
                            
                            <form method="post" action="{{ path('product_delete', {id: product.id}) }}" class="d-inline" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?')">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-2"></i>Supprimer
                                </button>
                            </form>
                            
                            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}