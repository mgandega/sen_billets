{% extends 'base.html.twig' %}

{% block title %}Modifier {{ product.name }} - Produits{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('product_index') }}">Produits</a></li>
                <li class="breadcrumb-item"><a href="{{ path('product_show', {id: product.id}) }}">{{ product.name }}</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-warning text-dark py-4">
                        <h1 class="h3 mb-0 fw-bold">
                            <i class="bi bi-pencil me-2"></i>Modifier le produit
                        </h1>
                    </div>
                    
                    <div class="card-body p-5">
                        <form method="post">
                            <div class="mb-4">
                                <label for="name" class="form-label fw-bold">Nom du produit *</label>
                                <input type="text" 
                                       class="form-control form-control-lg" 
                                       id="name" 
                                       name="name" 
                                       value="{{ product.name }}"
                                       required>
                                <div class="form-text">Le nom doit être unique et descriptif</div>
                            </div>

                            <div class="mb-4">
                                <label for="description" class="form-label fw-bold">Description</label>
                                <textarea class="form-control" 
                                          id="description" 
                                          name="description" 
                                          rows="5">{{ product.description }}</textarea>
                                <div class="form-text">Une description détaillée aide les clients à mieux comprendre votre produit</div>
                            </div>

                            <div class="mb-4">
                                <label for="price" class="form-label fw-bold">Prix (FCFA) *</label>
                                <div class="input-group input-group-lg">
                                    <input type="number" 
                                           class="form-control" 
                                           id="price" 
                                           name="price" 
                                           step="0.01" 
                                           min="0"
                                           value="{{ product.price }}"
                                           required>
                                    <span class="input-group-text">FCFA</span>
                                </div>
                                <div class="form-text">Prix en euros (ex: 999.99)</div>
                            </div>

                            <div class="alert alert-warning" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Attention :</strong> La modification de ce produit sera immédiatement visible.
                            </div>

                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="bi bi-check-circle me-2"></i>Sauvegarder les modifications
                                </button>
                                
                                <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-circle me-2"></i>Annuler
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}