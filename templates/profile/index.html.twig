{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
{# {% set spent = user.totalSpent/100 %} #}
<div class="min-h-screen bg-gradient-to-r from-purple-500 via-pink-500 to-yellow-400 p-6">
    <div class="bg-white shadow-2xl rounded-3xl p-10 max-w-6xl mx-auto">
        <!-- Header Profil -->
        <div class="flex items-center space-x-6">
            <div class="relative">
                {# <img src="{{ user.avatar ?? '/images/default-avatar.png' }}" alt="Photo de profil" class="w-28 h-28 rounded-full border-4 border-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 object-cover shadow-lg"> #}
                <span class="absolute top-0 right-0 bg-gradient-to-r from-yellow-400 via-pink-500 to-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full animate-pulse shadow-xl">PREMIUM</span>
            </div>
            <div>
                <h1 class="text-4xl font-extrabold text-gray-800">{{ user.fullName }}</h1>
