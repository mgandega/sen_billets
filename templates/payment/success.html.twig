{# templates/payment/success.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Paiement réussi{% endblock %}

{% block body %}
    <h1>Paiement validé</h1>

    <p>Merci pour votre achat. Votre paiement #{{ payment.id }} a été confirmé.</p>

    <h2>Billets</h2>
    <ul>
    {% for item in tickets %}
        <li>
            <strong>{{ item.event.title }}</strong>
            {% if item.qrCodeImagePath %}
                — <img src="{{ app.request.schemeAndHttpHost ~ item.qrCodeImagePath }}" alt="QR" style="height:36px;vertical-align:middle;margin-left:8px">
            {% endif %}
        </li>
    {% endfor %}
    </ul>

    <p>
        Vous pouvez télécharger votre facture <a href="{{ payment.invoicePath }}">ici</a> (PDF).
    </p>
{% endblock %}
