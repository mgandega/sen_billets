{# templates/payment/success.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Paiement réussi{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <span class="me-2">✅</span>
        <div>
            <h1 class="h4 mb-0">Paiement validé</h1>
            <p class="mb-0">Merci pour votre achat. Votre paiement <strong>#{{ payment.id }}</strong> a été confirmé.</p>
        </div>
    </div>

    <section class="mt-4">
        <h2 class="h5 mb-3">🎟️ Vos billets</h2>
        <ul class="list-group">
        {% for ticket in tickets %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>{{ ticket.event.title }}</span>
                <div class="d-flex align-items-center gap-2">
                    {% if ticket.qrCodeImagePath %}
                        <img src="{{ app.request.schemeAndHttpHost ~ ticket.qrCodeImagePath }}" 
                             alt="QR" 
                             style="height:36px;">
                    {% endif %}
                    {% if ticket.pdfPath %}
                        <a href="{{ ticket.pdfPath }}" target="_blank" class="btn btn-sm btn-outline-primary">
                            📄 PDF
                        </a>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
        </ul>
    </section>

    <section class="mt-4">
        <h2 class="h5 mb-3">📄 Facture</h2>
        <div class="d-flex gap-3">
            <a href="{{ payment.invoicePath }}" target="_blank" class="btn btn-outline-secondary">
                👁️ Voir la facture
            </a>
            <a href="{{ path('invoice_download', {id: payment.id}) }}" class="btn btn-primary">
                ⬇️ Télécharger la facture
            </a>
        </div>
    </section>

    {# {% if tickets|length > 1 %}
        <section class="mt-4">
            <h2 class="h5 mb-3">📥 Tous les tickets PDF</h2>
            <div class="d-flex gap-3">
                <a href="{{ path('tickets_download', {id: payment.id}) }}" class="btn btn-success">
                    ⬇️ Télécharger tous les tickets
                </a>
            </div>
        </section>
    {% endif %} #}
    {% if payment.ticketsPath %}
    {# <div>
    <a href="{{ path('tickets_download', {id: payment.id}) }}" class="btn btn-success">
        ⬇️ Télécharger tous les tickets
    </a>
    </div> #}
            <section class="mt-4">
            <h2 class="h5 mb-3">📥 Tous les tickets PDF</h2>
            <div class="d-flex gap-3">
    <a href="{{ path('tickets_download', {id: payment.id}) }}" class="btn btn-success">
                    ⬇️ Télécharger tous les tickets
                </a>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
