{% extends 'base.html.twig' %}

{% block title %}Confirmation de paiement - Sen-Billets{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://js.stripe.com/v3/"></script>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="text-center mb-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock text-primary" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-4 fw-bold text-primary mb-3">Confirmation requise</h1>
                    <p class="lead text-muted">Veuillez compléter l'authentification pour finaliser votre paiement</p>
                </div>

                <div class="card border-0 shadow">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                            <p class="mt-3">Redirection vers votre banque pour l'authentification...</p>
                        </div>
                        
                        <div id="payment-message" class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Pour des raisons de sécurité, votre banque demande une vérification supplémentaire.
                            Veuillez ne pas fermer cette fenêtre.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const stripe = Stripe('{{ stripe_public_key ?? "pk_test_placeholder" }}');
            const clientSecret = '{{ client_secret }}';
            const paymentId = '{{ payment_id }}';
            
            // Afficher le formulaire d'authentification 3D Secure
            stripe.confirmCardPayment(clientSecret).then(function(result) {
                if (result.error) {
                    // Erreur lors de l'authentification
                    showError(result.error.message);
                } else {
                    // Authentification réussie
                    if (result.paymentIntent.status === 'succeeded') {
                        showSuccess();
                        // Rediriger vers la page de succès
                        window.location.href = '/payment/success/' + paymentId;
                    } else {
                        showError("Le paiement n'a pas pu être complété. Veuillez réessayer.");
                    }
                }
            });
            
            function showError(message) {
                const messageContainer = document.getElementById('payment-message');
                messageContainer.className = 'alert alert-danger';
                messageContainer.innerHTML = `
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    ${message}
                `;
                
                // Ajouter un bouton pour retourner au panier
                const card = document.querySelector('.card-body');
                card.innerHTML += `
                    <div class="text-center mt-4">
                        <a href="/cart" class="btn btn-primary">Retour au panier</a>
                    </div>
                `;
                
                // Masquer le spinner
                document.querySelector('.spinner-border').style.display = 'none';
            }
            
            function showSuccess() {
                const messageContainer = document.getElementById('payment-message');
                messageContainer.className = 'alert alert-success';
                messageContainer.innerHTML = `
                    <i class="bi bi-check-circle me-2"></i>
                    Paiement confirmé avec succès ! Redirection en cours...
                `;
            }
        });
    </script>
{% endblock %}