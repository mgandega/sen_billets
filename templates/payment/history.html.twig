{% extends 'base.html.twig' %}

{% block body %}
    <h2>Historique de mes paiements</h2>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Montant</th>
                <th>Méthode</th>
                <th>Statut</th>
                <th>QR Code</th>
            </tr>
        </thead>
        <tbody>
            {% for payment in payments %}
                <tr>
                    <td>{{ payment.createdAt|date('d/m/Y H:i') }}</td>
                    <td>{{ payment.amount }} FCFA</td>
                    <td>{{ payment.method }}</td>
                    <td>{{ payment.status }}</td>
                    <td>
                        {% if payment.qrCodeImagePath %}
                            <img src="{{ asset(payment.qrCodeImagePath) }}" alt="QR" width="60">
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
