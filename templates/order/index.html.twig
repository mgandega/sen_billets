{% extends 'base.html.twig' %}

{% block title %}Mes commandes - Symfony 7.2{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="display-5 fw-bold text-dark mb-4">Mes commandes</h1>

        {% if orders is empty %}
            <div class="text-center py-5">
                <div class="mb-4">
                    <svg width="64" height="64" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-3">Aucune commande trouvée</h3>
                <p class="text-muted mb-4">Vous n'avez pas encore passé de commande</p>
                <a href="{{ path('product_index') }}" class="btn btn-primary btn-lg">
                    Découvrir nos produits
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for order in orders %}
                    <div class="col-12">
                        <div class="card border-0 shadow card-hover">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-3">
                                        <h5 class="fw-bold mb-1">{{ order.orderNumber }}</h5>
                                        <small class="text-muted">{{ order.createdAt|date('d/m/Y à H:i') }}</small>
                                    </div>
                                    
                                    <div class="col-md-2">
                                        <span class="badge {{ order.statusBadgeClass }} fs-6">
                                            {{ order.statusLabel }}
                                        </span>
                                    </div>
                                    
                                    <div class="col-md-2">
                                        <span class="fw-bold fs-5 text-success">{{ order.totalAmount }} FCFA</span>
                                    </div>
                                    
                                    <div class="col-md-3">
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt me-1"></i>
                                            {{ order.shippingCity }}, {{ order.shippingCountry }}
                                        </small>
                                    </div>
                                    
                                    <div class="col-md-2 text-end">
                                        <a href="{{ path('order_show', {id: order.id}) }}" class="btn btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <p class="text-muted">{{ orders|length }} commande(s) trouvée(s)</p>
            </div>
        {% endif %}
    </div>
{% endblock %}