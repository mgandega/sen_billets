{% extends 'base.html.twig' %}

{% block title %}Analytics - {{ event.title }} - Sen-Billets{% endblock %}

{% block body %}
    <div class="container py-5">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 fw-bold">Analytics détaillées</h1>
                        <p class="text-muted mb-0">{{ event.title }}</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('analytics_dashboard', {id: event.id}) }}" class="btn btn-outline-info">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard temps réel
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-download me-2"></i>Exporter
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('analytics_export', {id: event.id, type: 'full'}) }}">
                                    <i class="bi bi-file-spreadsheet me-2"></i>Rapport complet (CSV)
                                </a></li>
                                <li><a class="dropdown-item" href="{{ path('analytics_export', {id: event.id, type: 'sales'}) }}">
                                    <i class="bi bi-graph-up me-2"></i>Données de ventes (CSV)
                                </a></li>
                                <li><a class="dropdown-item" href="{{ path('analytics_export', {id: event.id, type: 'attendance'}) }}">
                                    <i class="bi bi-people me-2"></i>Données de présence (CSV)
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('analytics_pdf', {id: event.id}) }}">
                                    <i class="bi bi-file-pdf me-2"></i>Rapport PDF
                                </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overview Cards -->
        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow h-100">
                    <div class="card-body text-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-ticket text-primary fs-3"></i>
                        </div>
                        <h3 class="fw-bold">{{ report.overview.sold }}</h3>
                        <p class="text-muted mb-2">Billets vendus</p>
                        <small class="text-primary">{{ report.overview.capacity }} places total</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow h-100">
                    <div class="card-body text-center">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-currency-dollar text-success fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-success">{{ (report.overview.totalRevenue / 100)|number_format(0, ',', ' ') }}</h3>
                        <p class="text-muted mb-2">Revenus (FCFA)</p>
                        <small class="text-success">{{ (report.overview.averageTicketPrice / 100)|number_format(0, ',', ' ') }} FCFA/billet</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow h-100">
                    <div class="card-body text-center">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-percent text-warning fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-warning">{{ report.overview.occupancyRate|round }}%</h3>
                        <p class="text-muted mb-2">Taux d'occupation</p>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-warning" style="width: {{ report.overview.occupancyRate }}%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow h-100">
                    <div class="card-body text-center">
                        <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-check-circle text-info fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-info">{{ report.overview.validationRate|round }}%</h3>
                        <p class="text-muted mb-2">Taux de présence</p>
                        <small class="text-info">{{ report.overview.validated }} validés</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Sales Analytics -->
            <div class="col-lg-8">
                <div class="card border-0 shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-graph-up me-2"></i>Évolution des ventes
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="salesChart" height="300"></canvas>
                    </div>
                </div>

                <!-- Revenue Analytics -->
                <div class="card border-0 shadow mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-currency-dollar me-2"></i>Analyse des revenus
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <canvas id="revenueChart" height="250"></canvas>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-3">Répartition par type de billet</h6>
                                {% for ticketType in report.sales.byTicketType %}
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <strong>{{ ticketType.name }}</strong>
                                            <small class="text-muted d-block">{{ ticketType.sold }} vendus</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold">{{ (ticketType.revenue / 100)|number_format(0, ',', ' ') }} FCFA</span>
                                            <div class="progress mt-1" style="width: 100px; height: 4px;">
                                                {% set percentage = report.overview.totalRevenue > 0 ? (ticketType.revenue / report.overview.totalRevenue * 100) : 0 %}
                                                <div class="progress-bar bg-success" style="width: {{ percentage }}%"></div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Attendance Analytics -->
                <div class="card border-0 shadow">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-people me-2"></i>Analyse de présence
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="attendanceChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Sidebar Analytics -->
            <div class="col-lg-4">
                <!-- Key Metrics -->
                <div class="card border-0 shadow mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0 fw-bold">Métriques clés</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h4 fw-bold text-primary">{{ report.sales.peakSalesHour.hour ?? 'N/A' }}h</div>
                                    <small class="text-muted">Pic de ventes</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h4 fw-bold text-success">{{ report.attendance.peakAttendanceHour.hour ?? 'N/A' }}h</div>
                                    <small class="text-muted">Pic d'affluence</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h4 fw-bold text-warning">{{ report.attendance.noShowRate|round(1) }}%</div>
                                    <small class="text-muted">Taux no-show</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h4 fw-bold text-info">{{ report.demographics.uniqueCustomers }}</div>
                                    <small class="text-muted">Clients uniques</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="card border-0 shadow mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0 fw-bold">Timeline des ventes</h5>
                    </div>
                    <div class="card-body">
                        {% for week in report.timeline.salesTimeline|slice(-6) %}
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">Semaine {{ week.week }}</small>
                                <div class="d-flex align-items-center">
                                    <div class="progress me-2" style="width: 60px; height: 6px;">
                                        {% set maxSales = 100 %}
                                        <div class="progress-bar bg-primary" style="width: {{ (week.sales / maxSales * 100)|round }}%"></div>
                                    </div>
                                    <span class="fw-bold">{{ week.sales }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Predictions -->
                {% if report.predictions.message is not defined %}
                    <div class="card border-0 shadow">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0 fw-bold">Prédictions</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <small class="text-muted">Ventes projetées</small>
                                <div class="h5 fw-bold">{{ report.predictions.projectedSales }}</div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Occupation projetée</small>
                                <div class="h5 fw-bold">{{ report.predictions.projectedOccupancy|round }}%</div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" style="width: {{ report.predictions.projectedOccupancy }}%"></div>
                                </div>
                            </div>
                            {% if report.predictions.sellOutDate %}
                                <div class="alert alert-info">
                                    <small><strong>Complet prévu :</strong><br>{{ report.predictions.sellOutDate|date('d/m/Y') }}</small>
                                </div>
                            {% endif %}
                            {% if report.predictions.recommendations %}
                                <div class="mt-3">
                                    <small class="text-muted">Recommandations :</small>
                                    {% for recommendation in report.predictions.recommendations %}
                                        <div class="alert alert-warning py-2 mt-2">
                                            <small>{{ recommendation }}</small>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Sales Chart
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: [{% for day in report.sales.byDay %}'{{ day.date|date("d/m") }}'{% if not loop.last %},{% endif %}{% endfor %}],
                datasets: [{
                    label: 'Ventes',
                    data: [{% for day in report.sales.byDay %}{{ day.count }}{% if not loop.last %},{% endif %}{% endfor %}],
                    borderColor: 'rgb(13, 110, 253)',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    tension: 0.4,
                    fill: true
                }, {
                    label: 'Revenus (k FCFA)',
                    data: [{% for day in report.sales.byDay %}{{ (day.revenue / 100000)|round(1) }}{% if not loop.last %},{% endif %}{% endfor %}],
                    borderColor: 'rgb(25, 135, 84)',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    tension: 0.4,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, position: 'left' },
                    y1: { type: 'linear', display: true, position: 'right', beginAtZero: true }
                }
            }
        });

        // Revenue Chart (Pie)
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'doughnut',
            data: {
                labels: [{% for type in report.sales.byTicketType %}'{{ type.name }}'{% if not loop.last %},{% endif %}{% endfor %}],
                datasets: [{
                    data: [{% for type in report.sales.byTicketType %}{{ type.revenue }}{% if not loop.last %},{% endif %}{% endfor %}],
                    backgroundColor: [
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(25, 135, 84, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(220, 53, 69, 0.8)',
                        'rgba(13, 202, 240, 0.8)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // Attendance Chart
        const attendanceCtx = document.getElementById('attendanceChart').getContext('2d');
        new Chart(attendanceCtx, {
            type: 'bar',
            data: {
                labels: [{% for hour in 0..23 %}'{{ hour }}h'{% if not loop.last %},{% endif %}{% endfor %}],
                datasets: [{
                    label: 'Validations',
                    data: [
                        {% for hour in 0..23 %}
                            {% set count = 0 %}
                            {% for validation in report.attendance.byHour %}
                                {% if validation.hour == hour %}
                                    {% set count = validation.count %}
                                {% endif %}
                            {% endfor %}
                            {{ count }}{% if not loop.last %},{% endif %}
                        {% endfor %}
                    ],
                    backgroundColor: 'rgba(13, 202, 240, 0.8)',
                    borderColor: 'rgb(13, 202, 240)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
{% endblock %}