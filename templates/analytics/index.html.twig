{% extends 'base.html.twig' %}

{% block title %}Analytics - Sen-Billets{% endblock %}

{% block body %}
    <div class="container py-5">
        <!-- Header -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="display-4 fw-bold text-primary">Analytics & Rapports</h1>
                        <p class="lead text-muted">Analysez les performances de vos événements</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('analytics_trends') }}" class="btn btn-outline-info">
                            <i class="bi bi-graph-up-arrow me-2"></i>Tendances
                        </a>
                        <a href="{{ path('analytics_compare') }}" class="btn btn-outline-warning">
                            <i class="bi bi-bar-chart me-2"></i>Comparer
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {% if events is empty %}
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-graph-up text-muted" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold mb-3">Aucun événement trouvé</h3>
                <p class="text-muted mb-4">Créez votre premier événement pour voir les analytics</p>
                <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg">
                    Créer un événement
                </a>
            </div>
        {% else %}
            <!-- Quick Stats -->
            <div class="row g-4 mb-5">
                {% set totalRevenue = 0 %}
                {% set totalTickets = 0 %}
                {% set totalEvents = events|length %}
                {% set avgOccupancy = 0 %}

                {% for event in events %}
                    {% set totalTickets = totalTickets + event.soldTickets %}
                    {% set avgOccupancy = avgOccupancy + event.occupancyRate %}
                {% endfor %}

                {% if totalEvents > 0 %}
                    {% set avgOccupancy = avgOccupancy / totalEvents %}
                {% endif %}

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow h-100">
                        <div class="card-body text-center">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-calendar-event text-primary fs-3"></i>
                            </div>
                            <h3 class="fw-bold">{{ totalEvents }}</h3>
                            <p class="text-muted mb-0">Événements créés</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow h-100">
                        <div class="card-body text-center">
                            <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-ticket text-success fs-3"></i>
                            </div>
                            <h3 class="fw-bold text-success">{{ totalTickets|number_format(0, ',', ' ') }}</h3>
                            <p class="text-muted mb-0">Billets vendus</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow h-100">
                        <div class="card-body text-center">
                            <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-percent text-warning fs-3"></i>
                            </div>
                            <h3 class="fw-bold text-warning">{{ avgOccupancy|round }}%</h3>
                            <p class="text-muted mb-0">Taux moyen d'occupation</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow h-100">
                        <div class="card-body text-center">
                            <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-graph-up text-info fs-3"></i>
                            </div>
                            <h3 class="fw-bold text-info">{{ (totalTickets / totalEvents)|round }}</h3>
                            <p class="text-muted mb-0">Billets par événement</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Events List -->
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list me-2"></i>Vos événements
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0">Événement</th>
                                    <th class="border-0">Date</th>
                                    <th class="border-0">Statut</th>
                                    <th class="border-0">Vendus/Capacité</th>
                                    <th class="border-0">Occupation</th>
                                    <th class="border-0">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for event in events %}
                                    <tr>
                                        <td class="py-3">
                                            <div class="d-flex align-items-center">
                                                {% if event.imageUrl %}
                                                    <img src="{{ event.imageUrl }}" alt="{{ event.title }}" 
                                                         class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                                {% else %}
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" 
                                                         style="width: 50px; height: 50px;">
                                                        <i class="bi bi-calendar-event text-muted"></i>
                                                    </div>
                                                {% endif %}
                                                <div>
                                                    <h6 class="mb-0 fw-bold">{{ event.title }}</h6>
                                                    <small class="text-muted">{{ event.category }}</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-medium">{{ event.eventDate|date('d/m/Y') }}</span>
                                            <small class="text-muted d-block">{{ event.eventDate|date('H:i') }}</small>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge {{ event.status == 'published' ? 'bg-success' : 'bg-warning' }}">
                                                {{ event.status == 'published' ? 'Publié' : 'Brouillon' }}
                                            </span>
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-bold">{{ event.soldTickets }}</span>
                                            <span class="text-muted">/{{ event.capacity }}</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 8px;">
                                                    <div class="progress-bar bg-primary" 
                                                         style="width: {{ event.occupancyRate }}%"></div>
                                                </div>
                                                <span class="fw-bold">{{ event.occupancyRate|round }}%</span>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div class="btn-group btn-group-sm">
                                                <a href="{{ path('analytics_event', {id: event.id}) }}" 
                                                   class="btn btn-outline-primary" title="Analytics détaillées">
                                                    <i class="bi bi-graph-up"></i>
                                                </a>
                                                <a href="{{ path('analytics_dashboard', {id: event.id}) }}" 
                                                   class="btn btn-outline-info" title="Dashboard temps réel">
                                                    <i class="bi bi-speedometer2"></i>
                                                </a>
                                                <a href="{{ path('analytics_export', {id: event.id, type: 'full'}) }}" 
                                                   class="btn btn-outline-success" title="Exporter CSV">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                <a href="{{ path('analytics_pdf', {id: event.id}) }}" 
                                                   class="btn btn-outline-danger" title="Rapport PDF">
                                                    <i class="bi bi-file-pdf"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row g-4 mt-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0 fw-bold">Actions rapides</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="{{ path('analytics_trends') }}" class="btn btn-outline-info">
                                    <i class="bi bi-graph-up-arrow me-2"></i>Voir les tendances
                                </a>
                                <button class="btn btn-outline-warning" onclick="showCompareModal()">
                                    <i class="bi bi-bar-chart me-2"></i>Comparer des événements
                                </button>
                                <a href="{{ path('event_new') }}" class="btn btn-outline-primary">
                                    <i class="bi bi-plus-circle me-2"></i>Créer un nouvel événement
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0 fw-bold">Conseils & Recommandations</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="bi bi-lightbulb text-warning me-2"></i>
                                    Analysez vos pics de vente pour optimiser vos futures campagnes
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-lightbulb text-warning me-2"></i>
                                    Surveillez le taux de no-show pour ajuster votre capacité
                                </li>
                                <li class="mb-0">
                                    <i class="bi bi-lightbulb text-warning me-2"></i>
                                    Comparez vos performances avec les événements similaires
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Compare Modal -->
    <div class="modal fade" id="compareModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Comparer des événements</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="{{ path('analytics_compare') }}" method="get">
                    <div class="modal-body">
                        <p class="text-muted">Sélectionnez les événements à comparer (2 minimum) :</p>
                        
                        {% for event in events %}
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="events[]" 
                                       value="{{ event.id }}" id="event{{ event.id }}">
                                <label class="form-check-label" for="event{{ event.id }}">
                                    <strong>{{ event.title }}</strong>
                                    <small class="text-muted d-block">{{ event.eventDate|date('d/m/Y') }} • {{ event.category }}</small>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Comparer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function showCompareModal() {
            const modal = new bootstrap.Modal(document.getElementById('compareModal'));
            modal.show();
        }

        // Validation du formulaire de comparaison
        document.querySelector('#compareModal form').addEventListener('submit', function(e) {
            const checked = this.querySelectorAll('input[type="checkbox"]:checked');
            if (checked.length < 2) {
                e.preventDefault();
                alert('Veuillez sélectionner au moins 2 événements à comparer');
            }
        });
    </script>
{% endblock %}