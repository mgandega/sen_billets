<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Billet #{{ ticket.id }}</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; }
        .ticket { border: 2px dashed #333; padding: 20px; margin: 20px auto; width: 400px; }
        .event-title { font-size: 20px; font-weight: bold; margin-bottom: 10px; }
        .info { margin: 5px 0; }
        .qrcode { margin-top: 15px; }
    </style>
</head>
<body>
    <div class="ticket">
        <div class="event-title">{{ ticket.event.title }}</div>
        <div class="info"><strong>Type :</strong> {{ ticket.ticketType.name }}</div>
        <div class="info"><strong>Nom :</strong> {{ ticket.customerName }}</div>
        <div class="info"><strong>Email :</strong> {{ ticket.customerEmail }}</div>
        <div class="info"><strong>Status :</strong> {{ ticket.getStatusLabel() }}</div>
        <div class="qrcode">
            {% if ticket.getQrCodeBase64() %}
                <img src="data:image/png;base64,{{ ticket.getQrCodeBase64() }}" width="150" height="150">
            {% endif %}
        </div>
    </div>
</body>
</html>
