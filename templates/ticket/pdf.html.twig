<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 13px; }
        .ticket { border: 2px dashed #444; padding: 15px; margin: 10px; }
        .event-title { font-size: 18px; font-weight: bold; margin-bottom: 5px; }
        .event-info { margin-bottom: 15px; }
        .qrcode { text-align: center; margin-top: 15px; }
    </style>
</head>
<body>
    <div class="ticket">
        {# <div class="event-title">{{ ticket.event.title }}</div>
        <div class="event-info">
            <p><strong>Date :</strong> {{ ticket.event.date|date('d/m/Y H:i') }}</p>
            <p><strong>Lieu :</strong> {{ ticket.event.location }}</p>
            <p><strong>Type :</strong> {{ ticket.ticketType.name }}</p>
            <p><strong>Client :</strong> {{ ticket.customerName }} ({{ ticket.customerEmail }})</p>
        </div> #}
        {# ticket/pdf.html.twig #}
        {% for ticket in tickets %}
            <h2>Billet pour {{ ticket.event.title }}</h2>
            <p>Nom : {{ ticket.customerName }}</p>
            <p>Email : {{ ticket.customerEmail }}</p>
            <p>Type : {{ ticket.ticketType.name }}</p>
            <img src="{{ project_dir ~ '/public' ~ ticket.qrCodeImagePath }}" alt="QR Code">
            <hr>
        <div class="qrcode">
            <p>QR Code sécurisé :</p>
            <img src="data:image/png;base64,{{ ticket.getQrCodeBase64() }}" width="140" height="140">
        </div>
        {% endfor %}


    </div>
</body>
</html>
