{% extends 'base.html.twig' %}

{% block title %}Ticket n°{{ ticket.qrCode }}{% endblock %}

{% block body %}
    <h1>Votre ticket</h1>

    <p><strong>Nom :</strong> {{ ticket.customerName }}</p>
    <p><strong>Email :</strong> {{ ticket.customerEmail }}</p>
    <p><strong>Événement :</strong> {{ ticket.event.name }}</p>
    <p><strong>Date :</strong> {{ ticket.event.eventDate|date('d/m/Y H:i') }}</p>
    <p><strong>Statut :</strong> <span class="badge {{ ticket.getStatusBadgeClass() }}">{{ ticket.getStatusLabel() }}</span></p>

    <hr>

    {% if ticket.qrCodeImagePath is defined and ticket.qrCodeImagePath %}
        <img src="{{ absolute_url(asset(ticket.qrCodeImagePath)) }}" alt="QR Code" width="150">
    {% else %}
        <p>Aucun QR code disponible</p>
    {% endif %}


{% endblock %}
