{% extends 'base.html.twig' %}

{% block title %}Vérification du Ticket{% endblock %}

{% block body %}
    <div class="container mt-5 text-center">
        {% if status == 'valid' %}
            <h1 class="text-success">✅ {{ message }}</h1>
            <p><strong>Nom :</strong> {{ ticket.user.fullName }}</p>
            <p><strong>Événement :</strong> {{ ticket.event.title }}</p>
            <p><strong>Type :</strong> {{ ticket.ticketType.name }}</p>
            <p><strong>Statut :</strong> {{ ticket.status }}</p>
        {% else %}
            <h1 class="text-danger">❌ {{ message }}</h1>
        {% endif %}
    </div>
{% endblock %}
