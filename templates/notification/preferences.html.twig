{% extends 'base.html.twig' %}

{% block title %}Préférences de notification - Sen-Billets{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow">
                    <div class="card-header bg-primary text-white">
                        <h1 class="h3 mb-0 fw-bold">
                            <i class="bi bi-bell me-2"></i>Préférences de notification
                        </h1>
                    </div>
                    
                    <div class="card-body p-4">
                        <p class="text-muted mb-4">
                            Choisissez comment vous souhaitez être informé des actualités et événements sur Sen-Billets.
                        </p>

                        <form method="post">
                            <!-- Email Notifications -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-envelope me-2 text-primary"></i>Notifications par email
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" id="email_events" name="email_events" checked>
                                        <label class="form-check-label" for="email_events">
                                            <strong>Événements et billets</strong><br>
                                            <small class="text-muted">Confirmations d'achat, rappels d'événements, mises à jour importantes</small>
                                        </label>
                                    </div>
                                    
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="email_marketing" name="email_marketing" checked>
                                        <label class="form-check-label" for="email_marketing">
                                            <strong>Recommandations et promotions</strong><br>
                                            <small class="text-muted">Nouveaux événements, offres spéciales, newsletter hebdomadaire</small>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- SMS Notifications -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-phone me-2 text-success"></i>Notifications par SMS
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" id="sms_reminders" name="sms_reminders">
                                        <label class="form-check-label" for="sms_reminders">
                                            <strong>Rappels d'événements</strong><br>
                                            <small class="text-muted">SMS de rappel 24h avant vos événements</small>
                                        </label>
                                    </div>
                                    
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <small>Les SMS sont envoyés uniquement pour les notifications importantes. Des frais peuvent s'appliquer selon votre opérateur.</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Push Notifications -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-app-indicator me-2 text-warning"></i>Notifications push
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" id="push_notifications" name="push_notifications">
                                        <label class="form-check-label" for="push_notifications">
                                            <strong>Notifications en temps réel</strong><br>
                                            <small class="text-muted">Nouvelles ventes (organisateurs), rappels, mises à jour urgentes</small>
                                        </label>
                                    </div>
                                    
                                    <div id="push-status" class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <small>Les notifications push ne sont pas activées dans votre navigateur.</small>
                                        <button type="button" class="btn btn-sm btn-warning ms-2" id="enable-push-btn">
                                            Activer
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Frequency Settings -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-clock me-2 text-info"></i>Fréquence des notifications
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="digest_frequency" class="form-label">Résumé hebdomadaire</label>
                                            <select class="form-select" id="digest_frequency" name="digest_frequency">
                                                <option value="weekly">Chaque semaine</option>
                                                <option value="biweekly">Toutes les 2 semaines</option>
                                                <option value="monthly">Chaque mois</option>
                                                <option value="never">Jamais</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="reminder_timing" class="form-label">Rappels d'événements</label>
                                            <select class="form-select" id="reminder_timing" name="reminder_timing">
                                                <option value="24h">24 heures avant</option>
                                                <option value="12h">12 heures avant</option>
                                                <option value="6h">6 heures avant</option>
                                                <option value="2h">2 heures avant</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle me-2"></i>Sauvegarder les préférences
                                </button>
                                
                                <button type="button" class="btn btn-outline-secondary btn-lg" id="test-notifications">
                                    <i class="bi bi-send me-2"></i>Tester les notifications
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card border-0 shadow mt-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Actions rapides</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <button class="btn btn-outline-danger w-100" id="unsubscribe-all">
                                    <i class="bi bi-x-circle me-2"></i>Se désabonner de tout
                                </button>
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-outline-success w-100" id="subscribe-all">
                                    <i class="bi bi-check-circle me-2"></i>Tout réactiver
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Vérifier le statut des notifications push
            if ('Notification' in window) {
                const pushStatus = document.getElementById('push-status');
                const pushCheckbox = document.getElementById('push_notifications');
                
                if (Notification.permission === 'granted') {
                    pushStatus.className = 'alert alert-success';
                    pushStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i><small>Notifications push activées</small>';
                    pushCheckbox.checked = true;
                } else if (Notification.permission === 'denied') {
                    pushStatus.className = 'alert alert-danger';
                    pushStatus.innerHTML = '<i class="bi bi-x-circle me-2"></i><small>Notifications push bloquées par le navigateur</small>';
                    pushCheckbox.disabled = true;
                }
            }

            // Bouton d'activation des notifications push
            document.getElementById('enable-push-btn')?.addEventListener('click', function() {
                if (window.notificationManager) {
                    window.notificationManager.enableNotifications();
                }
            });

            // Test des notifications
            document.getElementById('test-notifications').addEventListener('click', function() {
                fetch('/api/notifications/test', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'type=welcome'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Notification de test envoyée ! Vérifiez votre email.');
                    } else {
                        alert('Erreur lors de l\'envoi de la notification de test.');
                    }
                });
            });

            // Actions rapides
            document.getElementById('unsubscribe-all').addEventListener('click', function() {
                if (confirm('Êtes-vous sûr de vouloir vous désabonner de toutes les notifications ?')) {
                    document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                }
            });

            document.getElementById('subscribe-all').addEventListener('click', function() {
                document.querySelectorAll('input[type="checkbox"]:not([disabled])').forEach(cb => cb.checked = true);
            });
        });
    </script>
{% endblock %}