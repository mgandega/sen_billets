{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Symfony 7.2{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5">
                    <h1 class="display-4 fw-bold text-primary mb-4">{{ title }}</h1>
                    <p class="lead text-muted">{{ description }}</p>
                </div>

                <div class="card border-0 shadow-lg">
                    <div class="card-body p-5">
                        <h2 class="h3 fw-bold mb-4">Architecture de l'application</h2>
                        
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <h4 class="h5 fw-bold text-primary">Backend</h4>
                                <ul class="list-unstyled">
                                    <li class="mb-2">✅ Symfony 7.2</li>
                                    <li class="mb-2">✅ Doctrine ORM</li>
                                    <li class="mb-2">✅ Twig Templates</li>
                                    <li class="mb-2">✅ Asset Mapper</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h4 class="h5 fw-bold text-success">Frontend</h4>
                                <ul class="list-unstyled">
                                    <li class="mb-2">✅ Bootstrap 5.3</li>
                                    <li class="mb-2">✅ CSS personnalisé</li>
                                    <li class="mb-2">✅ JavaScript moderne</li>
                                    <li class="mb-2">✅ Design responsive</li>
                                </ul>
                            </div>
                        </div>

                        <h3 class="h4 fw-bold mb-3">Fonctionnalités implémentées</h3>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-primary me-3">1</span>
                                    <span>Gestion des produits (CRUD)</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-success me-3">2</span>
                                    <span>Interface utilisateur moderne</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-warning me-3">3</span>
                                    <span>Base de données MySQL</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-info me-3">4</span>
                                    <span>Asset Mapper intégré</span>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <h4 class="alert-heading">💡 Note technique</h4>
                            <p class="mb-0">Cette application utilise Asset Mapper de Symfony 7.2 pour gérer les assets frontend sans avoir besoin de Webpack ou d'autres bundlers JavaScript complexes.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}